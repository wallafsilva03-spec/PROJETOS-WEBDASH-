# =====================================================================
# Credenciais públicas do Supabase usadas no build de produção.
#
# O Next.js lê este arquivo automaticamente durante `next build`, então a
# Vercel funciona sem nada configurado no painel dela.
#
# Pode ficar no repositório: os dois valores abaixo são públicos por
# natureza. Toda variável com prefixo NEXT_PUBLIC_ é embutida no código que
# roda no navegador — qualquer visitante consegue lê-los abrindo o site. Quem
# protege os dados são as políticas de Row Level Security no banco, não o
# sigilo destes valores.
#
# NUNCA coloque aqui a chave secreta (sb_secret_... ou service_role): essa
# ignora todas as regras de acesso e daria acesso total ao banco.
#
# Se um dia definir as mesmas variáveis no painel da Vercel, elas têm
# precedência sobre este arquivo.
# =====================================================================

# Project URL — Supabase → Project Settings → API.
# Também aparece na barra de endereço do painel:
#   supabase.com/dashboard/project/SUBSTITUA-PELA-SUA-REFERENCIA
# São 20 letras minúsculas.
NEXT_PUBLIC_SUPABASE_URL=https://xmkyhirmafvqmgewdrbd.supabase.co

# Chave pública — Supabase → Project Settings → API.
# Começa com "sb_publishable_" nos projetos novos, ou "eyJ" nos antigos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_q_0Kp_i4IY1VA6YJlGtLug_hszCl2sC

# Endereço público da aplicação.
NEXT_PUBLIC_SITE_URL=https://projetos-web-delta.vercel.app
